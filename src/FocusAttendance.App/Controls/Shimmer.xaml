<UserControl x:Class="FocusAttendance.App.Controls.Shimmer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid x:Name="Host">
        <StackPanel>
            <Border Height="12" Width="150" HorizontalAlignment="Left" CornerRadius="3"
                    Background="{DynamicResource SkeletonBrush}" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="30" Height="30" Fill="{DynamicResource SkeletonBrush}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Height="10" Width="160" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" Margin="0,0,0,6" />
                    <Border Height="8" Width="95" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="30" Height="30" Fill="{DynamicResource SkeletonBrush}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Height="10" Width="190" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" Margin="0,0,0,6" />
                    <Border Height="8" Width="70" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="30" Height="30" Fill="{DynamicResource SkeletonBrush}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Height="10" Width="135" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" Margin="0,0,0,6" />
                    <Border Height="8" Width="110" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource SkeletonBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
