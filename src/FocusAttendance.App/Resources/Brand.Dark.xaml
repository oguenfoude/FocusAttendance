<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FocusPlus executive palette — dark. -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="PrimaryColor">#3B82F6</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="#090D16" />
    <LinearGradientBrush x:Key="AppBgGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1120" Offset="0" />
        <GradientStop Color="#090D16" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E1B4B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#064E3B" />
    <SolidColorBrush x:Key="CautionBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="CautionSoftBrush" Color="#78350F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#0C4A6E" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassBrush" Color="#CC111827" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#66334155" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#1A60A5FA" />
    <SolidColorBrush x:Key="HeaderTintBrush" Color="#0F172A" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1220" Offset="0" />
        <GradientStop Color="#1E3A8A" Offset="0.55" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="PatternBrush" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Opacity="0.08">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <GeometryDrawing Geometry="M32,0 L64,32 L32,64 L0,32 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L64,64 M64,0 L0,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="0.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" />
    <DropShadowEffect x:Key="DrawerShadow" Color="#000000" BlurRadius="40" ShadowDepth="10" Direction="180" Opacity="0.65" />

</ResourceDictionary>
