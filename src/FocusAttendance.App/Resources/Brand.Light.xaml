<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FocusPlus executive palette — light. -->
    <Color x:Key="ShadowColor">#0F172A</Color>
    <Color x:Key="PrimaryColor">#2563EB</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="#F1F5F9" />
    <LinearGradientBrush x:Key="AppBgGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8FAFC" Offset="0" />
        <GradientStop Color="#EEF2F7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="CautionBrush" Color="#B45309" />
    <SolidColorBrush x:Key="CautionSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#64748B" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#660F172A" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="HeaderTintBrush" Color="#F8FAFC" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A8A" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="0.55" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="PatternBrush" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Opacity="0.10">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <GeometryDrawing Geometry="M32,0 L64,32 L32,64 L0,32 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L64,64 M64,0 L0,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="0.6" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.08" />
    <DropShadowEffect x:Key="DrawerShadow" Color="#0F172A" BlurRadius="36" ShadowDepth="8" Direction="180" Opacity="0.22" />

</ResourceDictionary>
