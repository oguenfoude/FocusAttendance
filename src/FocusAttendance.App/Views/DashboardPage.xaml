<UserControl x:Class="FocusAttendance.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:FocusAttendance.App.Controls"
             xmlns:loc="clr-namespace:FocusAttendance.App.Infrastructure">

    <!-- One single clean surface: header + hairline KPI strip + activity -->
    <Border Style="{StaticResource FluentCard}" Padding="0" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="26,22,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FOCUSPLUS • FOCUSATTENDANCE" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{DynamicResource Dashboard.Title}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                    <TextBlock Text="{DynamicResource Dashboard.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource NeutralSoftBrush}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource PillText}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryAction}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource App.Refresh}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hairline KPI strip (no individual cards) -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="24,18,16,18">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Dashboard.Employees}" Style="{StaticResource MetricLabel}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveEmployees}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Employees.Title}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Dashboard.Present}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PresentToday}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Dashboard.Late}" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="16,18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CautionBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Dashboard.Late}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding LateToday}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource CautionBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="> 08:15" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="16,18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Dashboard.Absent}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding AbsentToday}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Dashboard.NoScan}" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="16,18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource InfoBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Dashboard.OnLunch}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding OnLunchNow}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource InfoBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="12:00 — 13:00" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="16,18,24,18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{DynamicResource Dashboard.Devices}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding DevicesRatioText}" Style="{StaticResource MetricValue}"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{DynamicResource Dashboard.Terminals}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick actions -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryAction}" Command="{Binding PullAllCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dashboard.PullAll}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostAction}" Command="{Binding ScanCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dashboard.Scan}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostAction}" Command="{Binding SyncClocksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Dashboard.Sync}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Pill}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding TodayScans}" Style="{StaticResource PillText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activity + terminals, separated by a hairline -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="24,12,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Dashboard.Live}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Activity.Count}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource FlatGrid}" ItemsSource="{Binding Activity}" Margin="14,0,10,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [App.Name], Source={x:Static loc:Localized.Instance}}" Binding="{Binding Name}" Width="1.6*" />
                                <DataGridTextColumn Header="{Binding [App.Department], Source={x:Static loc:Localized.Instance}}" Binding="{Binding Department}" Width="1.2*" />
                                <DataGridTextColumn Header="{Binding [App.Device], Source={x:Static loc:Localized.Instance}}" Binding="{Binding Device}" Width="1*" />
                                <DataGridTextColumn Header="{Binding [Attendance.Morning], Source={x:Static loc:Localized.Instance}}" Binding="{Binding MorningIn}" Width="60" />
                                <DataGridTextColumn Header="{Binding [Attendance.LunchOut], Source={x:Static loc:Localized.Instance}}" Binding="{Binding LunchOut}" Width="72" />
                                <DataGridTextColumn Header="{Binding [Attendance.LunchIn], Source={x:Static loc:Localized.Instance}}" Binding="{Binding LunchIn}" Width="72" />
                                <DataGridTextColumn Header="{Binding [Attendance.Evening], Source={x:Static loc:Localized.Instance}}" Binding="{Binding EveningOut}" Width="62" />
                                <DataGridTextColumn Header="{Binding [Attendance.Net], Source={x:Static loc:Localized.Instance}}" Binding="{Binding WorkedText}" Width="60" />
                                <DataGridTemplateColumn Header="{Binding [App.Status], Source={x:Static loc:Localized.Instance}}" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GridStatusPill}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{DynamicResource Dashboard.NoActivity}" Style="{StaticResource EmptyStateText}"
                                   Visibility="{Binding Activity.Count, Converter={StaticResource ZeroCountToVisibility}}" />
                        <controls:Shimmer Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                          Margin="20" VerticalAlignment="Top" />
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,12,18,6">
                        <TextBlock Text="{DynamicResource Dashboard.Terminals}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DevicesRatioText}" Style="{StaticResource Caption}" Margin="8,4,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}" Margin="14,0,14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource DeviceDot}" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Style="{StaticResource Caption}" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Dashboard.NoDevice}" Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding Devices.Count, Converter={StaticResource ZeroCountToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
