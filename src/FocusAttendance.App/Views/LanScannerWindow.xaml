<ui:FluentWindow x:Class="FocusAttendance.App.Views.LanScannerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FocusAttendance.App.Infrastructure"
                 Title="LAN Scanner — FocusAttendance"
                 Width="1240" Height="740" MinWidth="940" MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="False"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Dubai, Tahoma">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Width="42" Height="42">
                <ui:SymbolIcon Symbol="Wifi124" FontSize="20" Foreground="{DynamicResource OnPrimaryBrush}" />
            </Border>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="{DynamicResource Scan.Title}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource Scan.Subtitle}" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Scan.Network}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="NetworkBox" MinWidth="220" MinHeight="38" DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Scan.From}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="RangeStartBox" Width="130" MinHeight="38" Text="192.168.1.1" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Scan.To}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="RangeEndBox" Width="130" MinHeight="38" Text="192.168.1.254" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Scan.CommKey}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="CommKeyBox" Width="90" MinHeight="38" Text="0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryAction}" Click="OnStartClick" Margin="0,0,8,0" AutomationProperties.AutomationId="ScanStartButton">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource Scan.Start}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource SecondaryAction}" Click="OnStopClick" IsEnabled="False" Margin="0,0,8,0" AutomationProperties.AutomationId="ScanStopButton">
                                <TextBlock Text="{DynamicResource Scan.Stop}" />
                            </Button>
                            <Button Style="{StaticResource GhostAction}" Click="OnCloseClick" Content="{DynamicResource App.Close}" AutomationProperties.AutomationId="ScanCloseButton" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FlatCard}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6" />
                    <TextBlock x:Name="ScanStatusText" Style="{StaticResource Caption}" Text="{DynamicResource Scan.Idle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="12,0,0,0">
                    <TextBlock x:Name="FoundCounter" Style="{StaticResource PillText}" Text="0" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FluentCard}" Padding="0">
            <DataGrid x:Name="ResultsGrid" Style="{StaticResource FlatGrid}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Margin="4,0,4,8" AutoGenerateColumns="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Scan.Ip}" Binding="{Binding IpAddress}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Scan.Status}" Binding="{Binding StatusText}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Devices.Serial}" Binding="{Binding Serial}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Devices.Model}" Binding="{Binding Model}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Devices.Users}" Binding="{Binding Users}" Width="86" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Devices.Punches}" Binding="{Binding Punches}" Width="86" IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource Scan.CommKey}" Binding="{Binding CommKey}" Width="84" />
                    <DataGridTemplateColumn Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostAction}" Content="{DynamicResource Scan.Retry}"
                                            Click="OnRetryClick" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                                    <Button Style="{StaticResource PrimaryAction}" Content="{Binding AddText}"
                                            Click="OnAddClick" Padding="10,4" FontSize="11" IsEnabled="{Binding CanAdd}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Everything the terminal answered, for the selected row -->
        <Border Grid.Row="4" Style="{StaticResource FlatCard}" Padding="16,12" Margin="0,10,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel>
                    <StackPanel Visibility="{Binding SelectedSerial, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="120">
                        <TextBlock Text="{DynamicResource Devices.Serial}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedSerial}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedModel, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="120">
                        <TextBlock Text="{DynamicResource Devices.Model}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedModel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedFirmware, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="110">
                        <TextBlock Text="{DynamicResource Devices.Firmware}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedFirmware}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedMac, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="130">
                        <TextBlock Text="MAC" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedMac}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedPlatform, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="110">
                        <TextBlock Text="Platform" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedPlatform}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedBiometrics, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="110">
                        <TextBlock Text="FP / Face" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedBiometrics}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedClock, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="110">
                        <TextBlock Text="{DynamicResource Devices.Clock}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedClock}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedUsers, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="90">
                        <TextBlock Text="{DynamicResource Devices.Users}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedUsers}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedPunches, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="90">
                        <TextBlock Text="{DynamicResource Devices.Punches}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedPunches}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedStatusDetail, Converter={StaticResource StringEmptyToVisibility}}" Margin="0,0,22,8" MinWidth="120">
                        <TextBlock Text="{DynamicResource App.Status}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedStatusDetail}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource SecondaryAction}" Content="{DynamicResource Scan.Retry}"
                            Click="OnRetrySelectedClick" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="ScanRetrySelectedButton" />
                    <Button Style="{StaticResource PrimaryAction}" Content="{Binding SelectedRow.AddText}"
                            Click="OnAddSelectedClick" IsEnabled="{Binding SelectedRow.CanAdd}"
                            AutomationProperties.AutomationId="ScanAddSelectedButton" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Text="{DynamicResource Scan.Hint}" TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
