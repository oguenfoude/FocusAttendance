<ui:FluentWindow x:Class="FocusAttendance.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FocusAttendance — FocusPlus"
                 Width="1440" Height="900" MinWidth="1200" MinHeight="760"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Dubai, Tahoma">

    <Grid x:Name="Root" Background="{DynamicResource AppBgGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FocusAttendance" Header="FocusPlus · OPGI M'Sila" ShowHelp="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: branding, workspaces, language/theme, operator -->
            <Border Grid.Column="0" Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Margin="8,6,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,14,20,18">
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="FOCUSPLUS" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="9" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="FocusAttendance" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                        <TextBlock x:Name="BrandBranch" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0">
                        <RadioButton x:Name="NavDashboard" AutomationProperties.AutomationId="NavDashboardButton" GroupName="nav" Tag="dashboard" Style="{StaticResource NavItem}"
                                     IsChecked="True" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Dashboard}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDevices" AutomationProperties.AutomationId="NavDevicesButton" GroupName="nav" Tag="devices" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Scan24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Devices}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavEmployees" AutomationProperties.AutomationId="NavEmployeesButton" GroupName="nav" Tag="employees" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Employees}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAttendance" AutomationProperties.AutomationId="NavAttendanceButton" GroupName="nav" Tag="attendance" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Attendance}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" AutomationProperties.AutomationId="NavSettingsButton" GroupName="nav" Tag="settings" Style="{StaticResource NavItem}" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Settings}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="12,0,12,12">
                        <Border Background="{DynamicResource NeutralSoftBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostAction}" Click="OnLanguageClick" HorizontalAlignment="Left" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock x:Name="SidebarLanguage" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource IconAction}" Click="OnThemeClick"
                                        ToolTip="{DynamicResource App.Theme}">
                                    <ui:SymbolIcon x:Name="SidebarThemeIcon" Symbol="WeatherSunny24" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="12" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock x:Name="UserInitials" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserName" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="UserRoleText" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconAction}" Click="OnLogoutClick"
                                        ToolTip="{DynamicResource App.Logout}">
                                    <ui:SymbolIcon Symbol="ArrowExit24" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: one clean surface -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" Margin="22,6,22,14" />
                <ui:ContentDialogHost x:Name="DialogHost" Panel.ZIndex="80" />
                <ui:SnackbarPresenter x:Name="SnackbarHost" Panel.ZIndex="70"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,26,0" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource GlassBrush}" Padding="18,6"
                Margin="8,0,8,8" CornerRadius="12"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusDbText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MonitorText" Style="{StaticResource Caption}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClockText" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
